## 4. Pseudocode — R6Δ

```
main(argv):
  r := phaseA(argv)                                  # A01–A05 (A05: --now parse, §1.2)
  if r is failure: emit(r with snapshot=none); exit 2

  try:    S0f := snap_files()
  except SnapshotError: emit(TF(snapshot-unreadable-initial, B01, provisional="-", snapshot=none)); exit 2

  S0r := NONE; prov := NONE
  try:
      prov := phaseC(S0f)                            # sets S0r after preflight
  except HelperFailure as f: prov := TF(f.code, f.trace)
  except BaseException:      prov := TF(internal, C14)

  if prov is K-result and S0r = NONE:                # invariant I-1 (unreachable by construction)
      prov := TF(internal, C14)
  scope := "full" if S0r ≠ NONE else "files-only"

  try:
      S1f := snap_files()
      S1r := snap_refs() if S0r ≠ NONE else NONE
  except BaseException:
      final := TF(snapshot-unreadable-final, D01, provisional=prov.trace, snapshot=final-unreadable)
  else:
      if S1f ≠ S0f or (S0r ≠ NONE and S1r ≠ S0r):
          final := TF(snapshot-changed, D02, provisional=prov.trace, snapshot=scope)
      else:
          final := prov with snapshot=scope                       # D00; I-2: scope=files-only only for C rows
  final.recommend := recommend(final)                             # §1.10; none for TF
  emit(final); exit (2 if final is TF else 0)

phaseC(S0f):
  preflight()                                         # C01–C05
  T := resolve_target()                               # C06, C07
  S0r := snap_refs()                                  # failure → C10
  FR := freshness(S0f, S0r, T, now, GF=CLOSED)        # §1.6; F18 unreachable, F22 instead
  return decide(C, T, FR)

decide(C, T, FR):
  if not cat-file -e C:              return K01
  if cat-file -t C ≠ commit:         raise C15
  if np(C) ≥ 3:                      return K02
  if C ⊑ T:
      P := oldest_fp_container(C)
      if P = C:                      I := direct(C)
      elif np(P) ≥ 3:                return K05
      elif np(P) = 2:
          if not (C ⊑ P^2 and C ⋢ P^1): raise C12
          I := via_merge(P)
      else:                          raise C12
      return finalize(I, FR)
  if np(C) = 2:                      return K03
  if paths(C) = ∅:                   return K04
  NB := merge-base --all C T
  if |NB| = 0:                       return K06
  if |NB| > 1:                       return K07
  refs, E := M1(C, T)                                 # PDB P-04: refs/remotes/origin/ only
  for X in E:
      n := |merge-base --all X T|
      if n > 1:                      return K08
      if n = 0:                      raise C12
  M2(); V, hits := M3_M4(E); V := M5(E, V)
  covering := M6(V)
  if covering ≠ ∅:                   return finalize(M7(covering), FR)   # K09; M7 tuple §1.8.2
  if covers(hits, C):                return K10
  if refs = ∅:                       return K11
  if cand(C, NB, V) ≠ ∅:             return K12
  return K13 if FR.fresh = yes else K14

finalize(I, FR):
  EV := events(I)          # §6 under PDB P-13/P-14/P-15
  PR := paths_reverted(I)
  CK := content(I)         # sets content_basis
  if EV = UNDETERMINABLE:            return K15
  if EV = UNORDERED:                 return K16
  if EV = INCOMPARABLE:              return K17
  if EV.kind_final = revert:         return K18
  if PR > 0:                         return K19
  if CK = unassessable:              return K20
  if CK = superseded:                return K21
  if CK = insufficient:              return K22
  return K23 if FR.fresh = yes else K24
```

- Every `return`/`raise` maps to exactly one §3 row, and every terminal §3 row is reached by exactly one path.
- No exception can escape `main` after phase A.

